<Window x:Class="ModOrganizer.App.Views.TagManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModOrganizer.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tags verwalten" Height="660" Width="900"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        d:DataContext="{d:DesignInstance Type=vm:TagManagerViewModel}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg1}" Padding="24,18"
                BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Tags" Style="{StaticResource H1}" />
                    <TextBlock Text="Anlegen, umbenennen, einfärben, beschreiben, löschen"
                               Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="NewTagBox" Width="220" Margin="0,0,6,0"
                             Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="NewTag_KeyDown"
                             ToolTip="Name eingeben und Enter drücken" />
                    <Button Content="Anlegen" Command="{Binding CreateTagCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="14,6" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Tag list -->
            <DataGrid Grid.Column="0" x:Name="Grid"
                      ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF"
                      HorizontalGridLinesBrush="{StaticResource Border1}"
                      Foreground="{StaticResource Text}"
                      SelectionMode="Single" Margin="16,12,8,12">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="42">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="14" Height="14" CornerRadius="7"
                                        Background="{Binding Swatch}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Benutzt" Binding="{Binding UsageText}" Width="110" />
                    <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Width="1" Background="{StaticResource Border1}" />

            <!-- Selected tag -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,20"
                            IsEnabled="{Binding SelectedTag, Converter={StaticResource NotNullToBool}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="18" Height="18" CornerRadius="9"
                                Background="{Binding SelectedTag.Swatch}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SelectedTag.Name, FallbackValue='Kein Tag gewählt'}"
                                   Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedTag.UsageText}" Style="{StaticResource Caption}" />

                    <TextBlock Text="FARBE" Style="{StaticResource Label}" Margin="0,22,0,6" />
                    <ItemsControl ItemsSource="{Binding Palette}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="26" Height="26" Margin="0,0,6,6" Padding="0"
                                        BorderThickness="0" Cursor="Hand"
                                        ToolTip="{Binding}"
                                        Command="{Binding DataContext.SetColorCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="13"
                                                    Background="{Binding Converter={StaticResource HexToBrush}}"
                                                    BorderBrush="#55FFFFFF" BorderThickness="1" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="BESCHREIBUNG" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <TextBox Text="{Binding SelectedTag.Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                             VerticalScrollBarVisibility="Auto" />
                    <Button Content="Beschreibung speichern" Command="{Binding SaveDescriptionCommand}"
                            Margin="0,8,0,0" Padding="12,6" HorizontalAlignment="Left" />

                    <Separator Margin="0,22,0,16" Background="{StaticResource Border1}" />

                    <Button Content="Umbenennen…" Command="{Binding RenameTagCommand}"
                            Padding="12,7" Margin="0,0,0,8" />
                    <Button Content="Tag löschen" Command="{Binding DeleteTagCommand}"
                            Padding="12,7" Background="#B3382F" Foreground="White" BorderThickness="0" />
                    <TextBlock Text="Löschen entfernt nur die Zuordnungen — die Mods bleiben."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Bg1}" Padding="24,10"
                BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}"
                           Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Schließen" Click="Close_Click" Padding="16,6" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
