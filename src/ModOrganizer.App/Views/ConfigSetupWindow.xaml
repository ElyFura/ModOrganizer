<Window x:Class="ModOrganizer.App.Views.ConfigSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModOrganizer — Setup" Height="540" Width="640"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Ersteinrichtung" Style="{DynamicResource H1}" />
            <TextBlock Text="Konfiguriere die Supabase/Postgres-Verbindung. Beide Werte findest du in deinem self-hosted Supabase Dashboard."
                       Style="{DynamicResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="POSTGRES-VERBINDUNG" Style="{DynamicResource Label}" Margin="0,0,0,6" />
            <TextBox x:Name="ConnBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Cascadia Code, Consolas" />
            <TextBlock Style="{DynamicResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap">
                <Run Text="Beispiel: Host=supabase.example.com;Port=5432;Database=postgres;Username=postgres;Password=...;SSL Mode=Require" />
            </TextBlock>

            <TextBlock Text="SUPABASE URL (optional, für Realtime+Auth)" Style="{DynamicResource Label}" Margin="0,18,0,6" />
            <TextBox x:Name="UrlBox" />

            <TextBlock Text="SUPABASE ANON KEY (optional)" Style="{DynamicResource Label}" Margin="0,14,0,6" />
            <TextBox x:Name="KeyBox" Height="52" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Cascadia Code, Consolas" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Abbrechen" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Content="Speichern" Click="Save_Click" Style="{DynamicResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
