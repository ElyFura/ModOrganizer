<Window x:Class="ModOrganizer.App.Views.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModOrganizer.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Duplicates" Height="700" Width="1000"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        d:DataContext="{d:DesignInstance Type=vm:DuplicatesViewModel}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg1}" Padding="24,18"
                BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Duplicates" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Neu suchen" Padding="14,6"
                        VerticalAlignment="Center"
                        Command="{Binding ReloadCommand}" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Bg1}" CornerRadius="8" Margin="0,0,0,14"
                                BorderBrush="{StaticResource Border1}" BorderThickness="1">
                            <StackPanel>
                                <!-- Group header -->
                                <Border Padding="16,12" Background="{StaticResource Bg2}" CornerRadius="8,8,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource Accent}" CornerRadius="4"
                                                    Padding="6,2" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SizeText}" Margin="12,0,0,0"
                                                       Foreground="{StaticResource TextDim}"
                                                       VerticalAlignment="Center" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Candidates, side by side per the plan -->
                                <ItemsControl ItemsSource="{Binding Mods}" Margin="10,10,10,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Bg2}" CornerRadius="6"
                                                    Padding="12,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding CategoryName}"
                                                                       Foreground="{StaticResource TextDim}" />
                                                            <TextBlock Text="/" Margin="5,0"
                                                                       Foreground="{StaticResource TextFaint}" />
                                                            <TextBlock Text="{Binding FolderName}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding RatingText}" Margin="10,0,0,0"
                                                                       Foreground="#FFD166" FontSize="11"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                                       Foreground="{StaticResource TextDim}" />
                                                            <TextBlock Text=" · " FontSize="11"
                                                                       Foreground="{StaticResource TextFaint}" />
                                                            <TextBlock Text="{Binding FilesText}" FontSize="11"
                                                                       Foreground="{StaticResource TextDim}" />
                                                            <TextBlock Text=" · geändert " FontSize="11"
                                                                       Foreground="{StaticResource TextFaint}" />
                                                            <TextBlock Text="{Binding ModifiedText}" FontSize="11"
                                                                       Foreground="{StaticResource TextDim}" />
                                                        </StackPanel>
                                                        <TextBlock Text="Ordner fehlt auf der Platte" FontSize="11"
                                                                   Foreground="#E5534B" Margin="0,4,0,0"
                                                                   Visibility="{Binding ExistsOnDisk,
                                                                                Converter={StaticResource BoolToCollapsed}}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Content="Explorer" Padding="10,5" Margin="0,0,6,0"
                                                                FontSize="11"
                                                                Command="{Binding DataContext.ShowInExplorerCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        <!-- Doubled underscore: WPF treats a single one as an
                                                             access-key marker and would render "Archiv". -->
                                                        <Button Content="→ __Archiv" Padding="10,5" Margin="0,0,6,0"
                                                                FontSize="11"
                                                                ToolTip="In die Kategorie _Archiv verschieben (Dateien bleiben erhalten)"
                                                                Command="{Binding DataContext.MoveToArchiveCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Papierkorb" Padding="10,5" FontSize="11"
                                                                Background="#B3382F" Foreground="White"
                                                                BorderThickness="0"
                                                                ToolTip="Als ZIP archivieren und in den Windows-Papierkorb verschieben"
                                                                Command="{Binding DataContext.SendToRecycleBinCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource Bg1}" Padding="24,10"
                BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Style="{StaticResource Caption}"
                           Text="„→ _Archiv“ verschiebt nur die Kategorie · „Papierkorb“ legt vorher ein ZIP unter %LOCALAPPDATA%\FFXIVModOrganizer\archive ab" />
                <Button DockPanel.Dock="Right" Content="Schließen" Click="Close_Click" Padding="16,6" />
            </DockPanel>
        </Border>

        <Grid Grid.RowSpan="3" Background="#AA000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="Arbeite…" Foreground="White" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
