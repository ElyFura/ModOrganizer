<Window x:Class="ModOrganizer.App.Views.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Papierkorb (gelöschte Mods)" Height="600" Width="900"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Bg1}" Padding="24,18"
                BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Papierkorb" Style="{DynamicResource H1}" />
                <TextBlock Text="Mods that were soft-deleted. You can restore them here (file folder must also be restored from the Windows Recycle Bin)."
                           Style="{DynamicResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" Margin="24,18" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mod" Binding="{Binding FolderName}" Width="*" />
                <DataGridTextColumn Header="Kategorie" Binding="{Binding CategoryName}" Width="140" />
                <DataGridTextColumn Header="Gelöscht" Binding="{Binding DeletedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                <DataGridTemplateColumn Header="Ordner vorhanden" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FolderExistsText}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="{DynamicResource Bg1}" Padding="24,14"
                BorderBrush="{DynamicResource Border1}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Auswahl wiederherstellen" Click="Restore_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" />
                <Button Content="Endgültig löschen" Click="HardDelete_Click" Style="{DynamicResource DangerButton}" Margin="0,0,8,0" />
                <Button Content="Schließen" Click="Close_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
