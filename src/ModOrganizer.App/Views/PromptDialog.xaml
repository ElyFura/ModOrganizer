<Window x:Class="ModOrganizer.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="420" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="22,18">
        <TextBlock x:Name="LabelText" Margin="0,0,0,8" />
        <TextBox x:Name="InputBox" Padding="6,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" IsCancel="True" Padding="14,5" Margin="0,0,8,0" />
            <Button Content="OK" IsDefault="True" Click="Ok_Click" Padding="14,5" />
        </StackPanel>
    </StackPanel>
</Window>
