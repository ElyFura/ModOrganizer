<Window x:Class="ModOrganizer.App.Views.CategoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModOrganizer.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Manage Categories" Height="660" Width="860"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        d:DataContext="{d:DesignInstance Type=vm:CategoryManagerViewModel}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg1}" Padding="24,18"
                BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Categories" Style="{StaticResource H1}" />
                    <TextBlock Text="Create, rename, reorder, merge or delete categories" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Root:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextDim}" />
                    <ComboBox ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}"
                              DisplayMemberPath="DisplayName" Width="240" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="{StaticResource Bg0}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" Margin="24,18,12,18"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Mods" Binding="{Binding ModCount}" Width="80" />
                    <DataGridCheckBoxColumn Header="Missing" Binding="{Binding IsMissing}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Width="1" Background="{StaticResource Border1}" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,18,24,18">
                    <TextBlock Text="ADD NEW" Style="{StaticResource Label}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCategoryCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Text="RENAME SELECTED" Style="{StaticResource Label}" Margin="0,20,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Apply" Command="{Binding RenameCategoryCommand}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Text="REORDER" Style="{StaticResource Label}" Margin="0,20,0,6" />
                    <UniformGrid Columns="2" Rows="1">
                        <Button Content="↑  Up" Command="{Binding MoveUpCommand}" Margin="0,0,3,0" />
                        <Button Content="↓  Down" Command="{Binding MoveDownCommand}" Margin="3,0,0,0" />
                    </UniformGrid>

                    <TextBlock Text="MERGE INTO" Style="{StaticResource Label}" Margin="0,20,0,6" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding MergeTarget}" DisplayMemberPath="Name" />
                    <Button Content="Merge selected → target" Command="{Binding MergeIntoTargetCommand}" Margin="0,6,0,0" />

                    <Border Height="1" Background="{StaticResource Border1}" Margin="0,24,0,14" />

                    <Button Content="Delete selected category" Command="{Binding DeleteCategoryCommand}"
                            Style="{StaticResource DangerButton}" Padding="12,8" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
