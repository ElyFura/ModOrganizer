<Window x:Class="ModOrganizer.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anmelden"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        Height="470" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="FFXIV Mod Organizer" Style="{DynamicResource H1}" />
            <TextBlock Text="Anmelden an der gemeinsamen Mod-Bibliothek"
                       Style="{DynamicResource Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Remembered account: shown instead of the email box once one is saved -->
        <Border Grid.Row="1" x:Name="SavedAccountPanel" Visibility="Collapsed"
                Background="{DynamicResource Bg2}" CornerRadius="6" Padding="12,10"
                BorderBrush="{DynamicResource Border1}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Anderer Benutzer" Padding="10,4" FontSize="11"
                        Click="SwitchUser_Click" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ANGEMELDET ALS" Style="{DynamicResource Label}" Margin="0,0,0,2" />
                    <TextBlock x:Name="SavedEmailText" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" x:Name="EmailPanel">
            <TextBlock Text="E-MAIL" Style="{DynamicResource Label}" />
            <TextBox x:Name="EmailBox" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="PASSWORT" Style="{DynamicResource Label}" />
            <PasswordBox x:Name="PasswordBox" Background="{DynamicResource Bg2}" Foreground="{DynamicResource Text}"
                         BorderBrush="{DynamicResource Border1}" BorderThickness="1" Padding="10,8" FontSize="13" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <CheckBox x:Name="StaySignedInBox" Content="Angemeldet bleiben"
                      ToolTip="Speichert das Anmelde-Token verschlüsselt für dieses Windows-Konto und überspringt diesen Dialog beim nächsten Start" />
            <TextBlock Text="Ohne Haken wird nur die Email gespeichert — das Passwort wird bei jedem Start gefragt."
                       Style="{DynamicResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                   Margin="0,12,0,0" TextWrapping="Wrap" VerticalAlignment="Top" />

        <!-- Ohne Anmeldung wird der Penumbra-Stand nicht geteilt. Das war in der Praxis der
             Grund, warum der andere Benutzer nichts sah. -->
        <TextBlock Grid.Row="5" Style="{DynamicResource Caption}" TextWrapping="Wrap"
                   VerticalAlignment="Bottom" Margin="0,0,0,2"
                   Text="Nur angemeldet siehst du, was der andere Benutzer in Penumbra aktiv hat — und er deinen Stand." />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Offline fortfahren" Click="Skip_Click" Margin="0,0,8,0"
                    ToolTip="Ohne Anmeldung siehst du deine Bibliothek, aber nichts vom anderen Benutzer — und dein Penumbra-Stand wird nicht geteilt." />
            <Button x:Name="SignInButton" Content="Anmelden" Click="SignIn_Click"
                    Style="{DynamicResource PrimaryButton}" IsDefault="True" Padding="18,7" />
        </StackPanel>
    </Grid>
</Window>
