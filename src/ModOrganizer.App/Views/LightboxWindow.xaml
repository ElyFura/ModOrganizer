<Window x:Class="ModOrganizer.App.Views.LightboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vorschau"
        WindowStyle="None" WindowState="Maximized"
        Background="#000000" Foreground="{DynamicResource Text}"
        AllowsTransparency="False" ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Grid x:Name="Host" Background="#000000"
          MouseLeftButtonDown="Host_MouseDown"
          MouseLeftButtonUp="Host_MouseUp"
          MouseMove="Host_MouseMove"
          MouseWheel="Host_MouseWheel"
          MouseRightButtonUp="Host_Close"
          ClipToBounds="True">
        <Image x:Name="Img" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               IsHitTestVisible="False">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="Pan" X="0" Y="0" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="#80000000" Padding="20,14">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TitleText" DockPanel.Dock="Left"
                           FontSize="14" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="CounterText" DockPanel.Dock="Right"
                           FontSize="12" Foreground="#AAAAAA" />
            </DockPanel>
        </Border>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#80000000" CornerRadius="6" Padding="14,8" Margin="0,0,0,24">
            <TextBlock Foreground="#CCCCCC" FontSize="11">
                <Run Text="← → blättern · Mausrad zoomt · ziehen verschiebt · Esc/Rechtsklick schließt · R setzt zurück" />
            </TextBlock>
        </Border>
    </Grid>
</Window>
