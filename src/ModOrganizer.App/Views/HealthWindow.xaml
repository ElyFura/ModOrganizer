<Window x:Class="ModOrganizer.App.Views.HealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot Health" Height="640" Width="960"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg1}" Padding="24,18"
                BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Screenshot health" Style="{StaticResource H1}" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Re-run" Click="Run_Click" Style="{StaticResource PrimaryButton}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Padding="24,18" Background="{StaticResource Bg0}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Severity" Binding="{Binding SeverityLabel}" Width="80" />
                    <DataGridTextColumn Header="Issue" Binding="{Binding KindLabel}" Width="120" />
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="160" />
                    <DataGridTextColumn Header="Mod" Binding="{Binding FolderName}" Width="*" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="260" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
