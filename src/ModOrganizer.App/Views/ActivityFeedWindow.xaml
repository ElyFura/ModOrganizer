<Window x:Class="ModOrganizer.App.Views.ActivityFeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activity Feed" Height="640" Width="720"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Bg1}" Padding="24,18"
                BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reload" Click="Reload_Click" />
                <StackPanel>
                    <TextBlock Text="Activity Feed" Style="{DynamicResource H1}" />
                    <TextBlock x:Name="SubtitleText" Style="{DynamicResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsList" Margin="20,14">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border1}"
                                BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                        Background="{Binding AvatarBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Initials, Mode=OneWay}" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="2,0,0,0">
                                    <TextBlock>
                                        <Run Text="{Binding UserDisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" " />
                                        <Run Text="{Binding Summary, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding ModFolderName, Mode=OneWay}" Style="{DynamicResource Caption}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TimeAgo, Mode=OneWay}"
                                           Style="{DynamicResource Caption}" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
